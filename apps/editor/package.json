{
  "name": "editor",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:workspace-deps": "bun x tsc --build ../../packages/core/tsconfig.json ../../packages/viewer/tsconfig.json",
    "sync-assets": "node ../../packages/editor-assets/bin/pascal-editor-assets.mjs sync --target ./public",
    "dev": "bun run build:workspace-deps && bun run sync-assets && dotenv -e ./.env.local --override -- next dev --webpack --port 3002",
    "build": "bun run build:workspace-deps && bun run sync-assets && dotenv -e ./.env.local --override -- next build --webpack",
    "start": "bun run sync-assets && next start",
    "lint": "biome lint",
    "check-types": "bun run build:workspace-deps && bun run sync-assets && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@iconify/react": "^6.0.2",
    "@number-flow/react": "^0.5.14",
    "@pascal-app/core": "*",
    "@pascal-app/editor": "*",
    "@pascal-app/editor-assets": "workspace:*",
    "@pascal-app/nodes": "*",
    "@pascal-app/viewer": "*",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/uikit-lucide": "^1.0.62",
    "@tailwindcss/postcss": "^4.2.1",
    "@visual-json/react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "geist": "^1.7.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.7.0",
    "mitt": "^3.0.1",
    "motion": "^12.34.3",
    "nanoid": "^5.1.6",
    "next": "16.2.1",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "three-mesh-bvh": "~0.9.8",
    "three": "^0.184.0",
    "zustand": "^5.0.11",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.19.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react-grab": "^0.1.25",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.2"
  }
}
