{
  "extends": "../typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "composite": false,
    "incremental": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"],
  "references": [{ "path": "../core" }, { "path": "../viewer" }]
}
